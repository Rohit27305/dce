/**
 * API client for backend communication.
 * Uses Axios for HTTP requests with automatic token injection.
 */

import axios from 'axios';

const API_BASE_URL = import.meta.env.VITE_API_URL || 'http://localhost:8000/api';

// Create axios instance
const apiClient = axios.create({
  baseURL: API_BASE_URL,
  headers: {
    'Content-Type': 'application/json',
  },
});

// Request interceptor - add auth token
apiClient.interceptors.request.use(
  (config) => {
    const token = localStorage.getItem('auth_token');
    if (token) {
      config.headers.Authorization = `Bearer ${token}`;
    }
    return config;
  },
  (error) => Promise.reject(error)
);

// Response interceptor - handle errors
apiClient.interceptors.response.use(
  (response) => response,
  (error) => {
    if (error.response?.status === 401) {
      // Unauthorized - clear token and redirect to login
      localStorage.removeItem('auth_token');
      window.location.href = '/login';
    }
    return Promise.reject(error);
  }
);

// API methods
export const api = {
  // Auth
  auth: {
    getGitHubLoginUrl: () => 
      apiClient.get('/auth/github/login'),
    getCurrentUser: () => 
      apiClient.get('/auth/me'),
  },

  // Repositories
  repositories: {
    list: () => 
      apiClient.get('/repositories'),
    get: (id: string) => 
      apiClient.get(`/repositories/${id}`),
    create: (data: any) => 
      apiClient.post('/repositories', data),
    update: (id: string, data: any) => 
      apiClient.put(`/repositories/${id}`, data),
    updateConfig: (id: string, config: any) => 
      apiClient.put(`/repositories/${id}/config`, config),
    delete: (id: string) => 
      apiClient.delete(`/repositories/${id}`),
  },

  // Documentation Updates
  documentationUpdates: {
    list: (params?: any) => 
      apiClient.get('/documentation-updates', { params }),
    get: (id: string) => 
      apiClient.get(`/documentation-updates/${id}`),
    submitFeedback: (id: string, feedback: any) => 
      apiClient.post(`/documentation-updates/${id}/feedback`, feedback),
  },

  // Metrics
  metrics: {
    getDashboard: () => 
      apiClient.get('/metrics/dashboard'),
    getRepositoryStats: (repoId: string) => 
      apiClient.get(`/metrics/repository/${repoId}`),
  },
};

export default apiClient;
```

