"""
Webhook processor worker.
Consumes webhook events from Redis queue and triggers agent orchestration.
"""

import asyncio
import logging
from datetime import datetime
from sqlalchemy.orm import Session

from src.core.database import SessionLocal
from src.core.redis_client import redis_client, WEBHOOK_QUEUE, IMPACT_ANALYSIS_QUEUE
from src.agents.invoker import agent_invoker
from src.models.repository import Repository
from src.integrations.github.client import github_client

logger = logging.getLogger(__name__)

class WebhookProcessor:
    """Processes webhook events from the queue"""
    
    def __init__(self):
        self.running = True
    
    async def start(self):
        """Start processing webhooks from queue"""
        logger.info("Webhook processor started")
        
        while self.running:
            try:
                # Get webhook event from queue (blocking with timeout)
                event = redis_client.dequeue(WEBHOOK_QUEUE, timeout=5)
                
                if event:
                    await self.process_event(event)
                else:
                    # No event in queue, continue waiting
                    await asyncio.sleep(1)
                    
            except Exception as e:
                logger.error(f"Error in webhook processor: {e}", exc_info=True)
                await asyncio.sleep(5)  # Back off on error
    
    async def process_event(self, event: dict):
        """
        Process a single webhook event.
        
        Args:
            event: Webhook event data from queue
        """
        logger.info(f"Processing webhook for {event['repository']['full_name']}")
        
        db = SessionLocal()
        try:
            # 1. Check if repository is monitored and enabled
            repo = db.query(Repository).filter(
                Repository.full_name == event['repository']['full_name']
            ).first()
            
            if not repo:
                logger.warning(f"Repository not found: {event['repository']['full_name']}")
                return
            
            if not repo.enabled:
                logger.info(f"Repository disabled: {repo.full_name}")
                return
            
            # Update last webhook timestamp
            repo.last_webhook_at = datetime.utcnow()
            db.commit()
            
            # 2. Fetch code diff from GitHub
            head_commit = event['head_commit']
            diff = await github_client.get_commit_diff(
                repo.owner,
                repo.name,
                head_commit['id']
            )
            
            # Enhance event with diff
            event['code_diff'] = diff
            
            # 3. Invoke Watcher Agent to analyze changes
            watcher_result = await agent_invoker.invoke_as_watcher(event)
            
            # 4. If documentation update needed, enqueue for impact analysis
            if watcher_result['requires_documentation_update']:
                change_events = watcher_result['change_events']
                
                logger.info(
                    f"Documentation update required: {len(change_events)} changes detected"
                )
                
                for change_event in change_events:
                    # Enqueue each change for impact analysis
                    impact_data = {
                        "repository_id": str(repo.id),
                        "change_event": change_event,
                        "trigger_commit": head_commit
                    }
                    
                    redis_client.enqueue(IMPACT_ANALYSIS_QUEUE, impact_data)
            else:
                logger.info("No documentation updates required")
        
        except Exception as e:
            logger.error(f"Error processing webhook event: {e}", exc_info=True)
        
        finally:
            db.close()
    
    def stop(self):
        """Stop the processor"""
        self.running = False
        logger.info("Webhook processor stopping...")

# Run the worker
if __name__ == "__main__":
