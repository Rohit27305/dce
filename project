### 2.3 Deploy Backend on App Platform
```yaml
# .do/app.yaml
name: doc-enforcer-backend
services:
  - name: api
    github:
      repo: your-username/doc-enforcer
      branch: main
      deploy_on_push: true
    source_dir: /backend
    build_command: pip install -r requirements.txt
    run_command: uvicorn src.main:app --host 0.0.0.0 --port 8080
    envs:
      - key: DATABASE_URL
        value: ${db.DATABASE_URL}
      - key: REDIS_URL
        value: ${redis.REDIS_URL}
      - key: SECRET_KEY
        value: ${SECRET_KEY}
      - key: GITHUB_CLIENT_ID
        value: ${GITHUB_CLIENT_ID}
      - key: GITHUB_CLIENT_SECRET
        value: ${GITHUB_CLIENT_SECRET}
      - key: DIGITALOCEAN_API_TOKEN
        value: ${DIGITALOCEAN_API_TOKEN}
      - key: AGENT_ID
        value: ${AGENT_ID}
    
  - name: webhook-worker
    github:
      repo: your-username/doc-enforcer
      branch: main
    source_dir: /backend
    run_command: python -m src.workers.webhook_processor
    envs: # Same as API
    
  - name: orchestrator-worker
    github:
      repo: your-username/doc-enforcer
      branch: main
    source_dir: /backend
    run_command: python -m src.workers.orchestrator
    envs: # Same as API

  - name: pr-worker
    github:
      repo: your-username/doc-enforcer
      branch: main
    source_dir: /backend
    run_command: python -m src.workers.pr_creator
    envs: # Same as API

static_sites:
  - name: frontend
    github:
      repo: your-username/doc-enforcer
      branch: main
    source_dir: /frontend
    build_command: npm run build
    output_dir: /dist
    envs:
      - key: VITE_API_URL
        value: https://api.yourdomain.com
```

