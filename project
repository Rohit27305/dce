    confidence_score DECIMAL(3,2),
    last_verified_at TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(repository_id, code_file_path, code_entity_name, doc_file_path)
);

CREATE INDEX idx_mappings_code_file ON code_doc_mappings(repository_id, code_file_path);
CREATE INDEX idx_mappings_doc_file ON code_doc_mappings(repository_id, doc_file_path);
