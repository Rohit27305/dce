    """Orchestrates the complete documentation update workflow"""
    
    def __init__(self):
        self.running = True
    
    async def start(self):
        """Start processing impact analysis queue"""
        logger.info("Agent orchestrator started")
        
        while self.running:
            try:
                # Get impact analysis task from queue
                task = redis_client.dequeue(IMPACT_ANALYSIS_QUEUE, timeout=5)
                
                if task:
                    await self.process_task(task)
                else:
                    await asyncio.sleep(1)
                    
            except Exception as e:
                logger.error(f"Error in orchestrator: {e}", exc_info=True)
                await asyncio.sleep(5)
    
    async def process_task(self, task: dict):
        """
        Process a single task: impact analysis → content generation → PR creation.
        
        Args:
            task: {
                "repository_id": str,
                "change_event": dict,
                "trigger_commit": dict
            }
        """
        logger.info(f"Processing documentation update task")
        
        db = SessionLocal()
        try:
            # 1. Get repository
            repo = db.query(Repository).filter(
                Repository.id == task['repository_id']
            ).first()
            
            if not repo:
                logger.error(f"Repository not found: {task['repository_id']}")
                return
            
            # 2. Get knowledge graph for this repository
            knowledge_graph = knowledge_graph_service.get_mappings(repo.id)
            
            # 3. Invoke Impact Analyzer Agent
            impact_result = await agent_invoker.invoke_as_impact_analyzer(
                task['change_event'],
                knowledge_graph
            )
            
            affected_docs = impact_result['affected_documents']
            
            if not affected_docs:
                logger.info("No affected documents identified")
                return
            
            logger.info(f"Impact analysis: {len(affected_docs)} documents affected")
            
            # 4. Generate documentation updates for each affected file
            doc_updates = []
            
            for doc in affected_docs:
                # Fetch existing documentation content from GitHub
                existing_content = await github_client.get_file_content(
                    repo.owner,
                    repo.name,
                    doc['file_path'],
                    repo.default_branch
                )
                
                if not existing_content:
                    logger.warning(f"Could not fetch {doc['file_path']}, skipping")
                    continue
                
                # Invoke Content Generator Agent
                update = await agent_invoker.invoke_as_content_generator(
                    task['change_event'],
                    existing_content,
                    doc['file_path']
                )
                
                # Add metadata
                update['file_path'] = doc['file_path']
                update['sections_affected'] = doc.get('sections_affected', [])
                
                doc_updates.append(update)
            
            if not doc_updates:
                logger.warning("No documentation updates generated")
                return
            
            # 5. Check confidence threshold
            avg_confidence = sum(u['confidence_score'] for u in doc_updates) / len(doc_updates)
            
            from src.core.config import settings
            
            if avg_confidence < settings.MIN_CONFIDENCE_THRESHOLD:
                logger.info(
                    f"Average confidence {avg_confidence:.2f} below threshold "
                    f"{settings.MIN_CONFIDENCE_THRESHOLD}, skipping PR creation"
                )
                return
            
            # 6. Create database record
            doc_update_record = DocumentationUpdate(
                repository_id=repo.id,
                trigger_commit_sha=task['trigger_commit']['id'],
                trigger_commit_message=task['trigger_commit'].get('message', ''),
                trigger_author=task['trigger_commit'].get('author', {}).get('name', ''),
                affected_files=[u['file_path'] for u in doc_updates],
                confidence_score=int(avg_confidence * 100),
                status=UpdateStatus.PENDING
            )
            
            db.add(doc_update_record)
            db.commit()
            db.refresh(doc_update_record)
            
            # 7. Generate PR description
            pr_description = await agent_invoker.invoke_as_pr_creator(
                doc_updates,
                task['change_event']
            )
            
            # 8. Enqueue for PR creation
            pr_data = {
                "update_id": str(doc_update_record.id),
                "repository_id": str(repo.id),
                "doc_updates": doc_updates,
                "pr_description": pr_description,
                "confidence_score": avg_confidence
            }
            
            redis_client.enqueue(PR_CREATION_QUEUE, pr_data)
            
            logger.info(f"Documentation update queued for PR creation: {doc_update_record.id}")
        
        except Exception as e:
            logger.error(f"Error processing orchestration task: {e}", exc_info=True)
        
        finally:
            db.close()
    
    def stop(self):
        self.running = False
        logger.info("Agent orchestrator stopping...")

if __name__ == "__main__":
    orchestrator = AgentOrchestrator()
    asyncio.run(orchestrator.start())
```

**Key Requirements:**
- Must coordinate all agent invocations in sequence
- Must fetch existing documentation from GitHub
- Must check confidence thresholds before proceeding
- Must create database records for tracking
- Must enqueue for PR creation if successful
- Must handle errors gracefully

