            # Extract content from API response
            content = raw_response["choices"][0]["message"]["content"]
            
            # Try to parse as JSON
            parsed = AgentResponseParser._extract_json(content)
            
            # Validate required fields
            required_fields = ["requires_documentation_update", "change_events"]
            for field in required_fields:
                if field not in parsed:
                    raise ValueError(f"Missing required field: {field}")
            
            # Validate types
            if not isinstance(parsed["requires_documentation_update"], bool):
                raise ValueError("requires_documentation_update must be boolean")
            
            if not isinstance(parsed["change_events"], list):
                raise ValueError("change_events must be a list")
            
            # Validate each change event
            for event in parsed["change_events"]:
